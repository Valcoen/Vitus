{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "src/lib/actor.ts",
    "src/lib/recipe/server.ts",
    "src/lib/**/*.tsx"
  ]
}
